{
  // Gnomon Studio — statik site, Cloudflare Workers statik varlıkları.
  //
  // ⚠️ HENÜZ KULLANILMIYOR. Site bugün GitHub Pages'ten yayımlanıyor,
  // çünkü eldeki Cloudflare token'ı Workers'a ve Pages'e YAZAMIYOR
  // (ölçüldü: DNS yazma açık, Workers yazma kapalı, token yönetimi kapalı).
  //
  // `Workers Scripts: Edit` yetkili bir token geldiğinde bu dosya hazır:
  // `npm run dagit` aynı docs/ klasörünü gönderir. O gün yapılacak tek
  // başka iş, DNS'i GitHub Pages IP'lerinden Worker'a çevirmek ve
  // public/CNAME dosyasını silmek (o GitHub Pages'e ait).
  "name": "gnomonstudio",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./docs",
    // Adresler .html uzantılı (uygulamanın içine gömülü), bu yüzden
    // sondaki eğik çizgiyle oynanmıyor.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
