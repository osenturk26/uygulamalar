---
import Temel from '../layouts/Temel.astro';
import { site, uygulamalar, epostaIcin, sayfaIcin } from '../data/site.js';
---

<Temel baslik="İletişim" aciklama={`${site.ad} iletişim adresleri.`}>
  <section class="bant bant--isik">
    <div class="kabuk giris">
      <p class="etiket">İletişim</p>
      <h1>Yazın</h1>
      <p class="giris__alt">
        Bir sorunuz ya da bildireceğiniz bir sorun varsa yazın.
        Genelde aynı gün içinde dönüyoruz.
      </p>
      <a class="genel" href={`mailto:${site.eposta}`}>
        <span class="genel__etiket">Genel konular</span>
        <span class="genel__adres"><!--email_off-->{site.eposta}<!--/email_off--></span>
      </a>
    </div>
  </section>

  <section class="bant bant--golge">
    <div class="kabuk bolum">
      <p class="etiket belir">Uygulama adresleri</p>
      <h2 class="bolum__baslik belir">Her uygulamanın kendi adresi var</h2>
      <p class="aciklama belir">
        Tek bir destek adresi yerine uygulama başına ayrı adres
        kullanıyoruz. İki sebebi var: gelen kutusunda sorunun hangi
        uygulamadan geldiği ilk bakışta belli oluyor, ve bir uygulama
        bir gün devredilirse adresi de onunla gidiyor.
      </p>

      <ul class="adresler">
        {uygulamalar.map((u) => (
          <li class="belir">
            <a class="adres" href={`mailto:${epostaIcin(u.slug)}`}>
              <img src={u.ikon} alt="" width="44" height="44" />
              <span class="adres__ad">{u.ad}</span>
              <span class="adres__posta"><!--email_off-->{epostaIcin(u.slug)}<!--/email_off--></span>
            </a>
          </li>
        ))}
      </ul>

      <p class="cikis belir">
        Kademe için sık sorulanlar ve ayarlarla ilgili yanıtlar
        <a href="/kademe/destek.html">destek sayfasında</a>.
        Uygulamanın kendisi <a href={sayfaIcin('kademe')}>burada</a>.
      </p>
    </div>
  </section>
</Temel>

<style>

  .giris { padding-block: clamp(44px, 7vw, 88px); max-width: var(--en-metin); }
  .giris h1 { margin-top: 10px; font-size: var(--t-2xl); }
  .giris__alt { margin-top: 18px; color: var(--metin-2); max-width: 40ch; }

  .genel {
    display: inline-flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 32px;
    padding: 20px 26px;
    border-radius: var(--yuvarlak-buyuk);
    border: 1px solid var(--ayrac);
    background: var(--yuzey-degrade), var(--yuzey);
    box-shadow: var(--dusey-gol-kucuk), var(--kenar-isik);
    text-decoration: none;
    color: var(--metin);
  }
  .genel:hover { border-color: color-mix(in srgb, var(--vurgu) 48%, var(--ayrac)); }
  .genel__etiket {
    font-size: var(--t-xs);
    font-weight: 620;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--metin-2);
  }
  .genel__adres {
    font-family: var(--yazi-baslik);
    font-size: clamp(1.25rem, 0.9rem + 1.4vw, 1.75rem);
    font-weight: 680;
    letter-spacing: -0.02em;
    color: var(--vurgu);
  }

  .bolum { padding-block: clamp(48px, 7vw, 88px); }
  .bolum__baslik { margin-top: 10px; max-width: 20ch; }
  .aciklama { margin-top: 18px; color: var(--metin-2); max-width: 52ch; }

  .adresler { list-style: none; padding: 0; margin: clamp(28px, 4vw, 40px) 0 0; }

  .adres {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 18px;
    padding: 18px 2px;
    text-decoration: none;
    color: var(--metin);
    border-top: 0;
    background-image: linear-gradient(
      90deg,
      rgb(245 241 232 / 0.30) 0%,
      rgb(245 241 232 / 0.10) 42%,
      rgb(245 241 232 / 0.04) 100%
    );
    background-size: 100% 1px;
    background-repeat: no-repeat;
    background-position: top left;
  }
  .adresler li:last-child .adres { box-shadow: inset 0 -1px 0 rgb(245 241 232 / 0.08); }
  .adres img { border-radius: 23%; box-shadow: var(--dusey-gol-kucuk); }
  .adres__ad { font-size: var(--t-l); font-weight: 660; letter-spacing: -0.02em; }
  .adres__posta { color: var(--vurgu); font-size: var(--t-s); font-weight: 560; }
  .adres:hover .adres__posta { text-decoration: underline; }

  /* Dar ekranda adres alta insin, üst üste binmesin */
  @media (max-width: 34rem) {
    .adres {
      grid-template-columns: auto 1fr;
      row-gap: 4px;
    }
    .adres__posta { grid-column: 2; }
  }

  .cikis { margin-top: 32px; color: var(--metin-2); max-width: 48ch; }
</style>
