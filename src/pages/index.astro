---
import Temel from '../layouts/Temel.astro';
import AnaEkran from '../components/AnaEkran.astro';
import UcurumEgrisi from '../components/UcurumEgrisi.astro';
import { site, uygulamalar, sayfaIcin } from '../data/site.js';

const kurallar = [
  {
    baslik: 'Bilmediğimizi söyleriz',
    govde: 'Ay başında okuman yoksa Kademe bunu söyler ve sonucu işaretler. Yanlış bir güven vermektense eksik olduğunu bilmen daha iyi.',
    kanit: 'Tahmini',
  },
  {
    baslik: 'Veri sende kalır',
    govde: 'Sayaç okumaların varsayılan olarak telefonundan çıkmaz. Hesaplar cihazında yapılır, internet gerekmez. Yedeklemeyi açmak senin kararın.',
    kanit: 'Cihazda',
  },
  {
    baslik: 'Tek soru, iyi cevap',
    govde: 'Her uygulama tek bir soruya cevap veriyor. Soruyu çoğaltmak yerine cevabı iyileştirmeyi tercih ediyoruz.',
    kanit: 'Bir soru',
  },
];
---

<Temel
  baslik={`${site.ad} — ${site.slogan}`}
  aciklama="Günlük hayatı kolaylaştıran mobil uygulamalar üretiyoruz. Göremediğin şeyi, iş işten geçmeden gösteririz."
  cipli={false}
>
  <section class="giris bant bant--isik">
    <div class="kabuk giris__ic">
      <div class="giris__yazi">
        <h1>{site.slogan}</h1>
        <p class="giris__alt">
          Mobil uygulamalar yapıyoruz. Hepsi tek bir soruya cevap veriyor ve
          cevabı, cevap hâlâ işe yarar durumdayken veriyor.
        </p>
        <p class="giris__dugmeler">
          <a class="dugme dugme--birincil" href={sayfaIcin('kademe')}>Kademe'yi incele</a>
          <a class="dugme dugme--ikincil" href="/hakkimizda.html">Neden Gnomon</a>
        </p>
      </div>
      <div class="giris__telefon"><AnaEkran /></div>
    </div>
  </section>

  <section class="bant bant--golge">
    <div class="kabuk bolum">
      <p class="etiket belir">Nasıl çalışıyoruz</p>
      <h2 class="bolum__baslik belir">Üç kural, üçü de Kademe'de görünür</h2>
      <div class="kurallar">
        {kurallar.map((k) => (
          <article class="kural belir">
            <h3>{k.baslik}</h3>
            <div class="kural__sag">
              <p>{k.govde}</p>
              <span class="kural__kanit">{k.kanit}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bant bant--isik">
    <div class="kabuk bolum">
      <p class="etiket belir">Uygulamalarımız</p>
      <h2 class="bolum__baslik belir">Bir nefes fazlanın bedeli</h2>
      <div class="ucurum">
        <div class="ucurum__gorsel belir"><UcurumEgrisi /></div>
        <div class="ucurum__yazi belir">
          <p class="ucurum__sayi"><span>1.204</span> ₺</p>
          <p class="ucurum__aciklama">
            İstanbul'da Kasım limiti <strong>136,01 Sm³</strong>. Limitte
            kalırsan fatura 2.307 TL; bir nefes aşarsan aynı gaz için
            3.511 TL. Pahalanan şey aşan kısım değil, ayın tamamı.
          </p>
          {uygulamalar.map((u) => (
            <a class="ucurum__app" href={sayfaIcin(u.slug)}>
              <img src={u.ikon} alt="" width="52" height="52" />
              <span>
                <b class="ucurum__ad">
                  <strong>{u.ad}</strong>
                  {u.durum === 'yakinda' && <i class="rozet">Yakında</i>}
                </b>
                <em>{u.altBaslik} — bu farkı aşmadan önce gösterir</em>
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Temel>

<style>
  /* Bantlar: bölümler sırayla ışığa ve gölgeye giriyor. Sayfanın ritmi
   * bu — her bandın kaynağı kendi sol üst köşesi. */
  .bant { position: relative; }
  .bant--isik { background: var(--bant-isik); }
  .bant--golge { background: none; }
  .bant + .bant { border-top: 1px solid var(--ayrac); }

  .giris { padding-block: clamp(40px, 6vw, 88px) clamp(48px, 7vw, 96px); }

  .giris__ic {
    display: grid;
    gap: clamp(36px, 6vw, 64px);
    align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 52rem) {
    .giris__ic { grid-template-columns: 1.05fr 0.95fr; }
  }

  .giris h1 { font-size: var(--t-3xl); font-weight: 700; max-width: 15ch; }
  .giris__alt {
    margin-top: 24px; max-width: 44ch;
    font-size: var(--t-l); color: var(--metin-2);
  }
  .giris__dugmeler { margin-top: 32px; display: flex; gap: 12px; flex-wrap: wrap; }
  .giris__telefon { display: flex; justify-content: center; }

  .bolum { padding-block: clamp(52px, 8vw, 96px); }
  .bolum__baslik { margin-top: 10px; max-width: 20ch; }

  /* Kutu yok. Satırlar, aralarında saç teli çizgi; ışık her satırın
   * üzerinden soldan geçiyor. Üç özdeş kart "şablon" gibi duruyordu. */
  .kurallar { margin-top: clamp(32px, 5vw, 56px); }

  .kural {
    display: grid;
    gap: 10px 40px;
    grid-template-columns: 1fr;
    padding-block: clamp(22px, 2.2vw, 30px);
    border-top: 0;
    background-image: linear-gradient(
      90deg,
      rgb(245 241 232 / 0.30) 0%,
      rgb(245 241 232 / 0.10) 42%,
      rgb(245 241 232 / 0.04) 100%
    );
    background-size: 100% 1px;
    background-repeat: no-repeat;
    background-position: top left;
  }
  .kural:last-child {
    padding-bottom: 0;
    box-shadow: inset 0 -1px 0 rgb(245 241 232 / 0.08);
    padding-bottom: clamp(22px, 2.2vw, 30px);
  }

  @media (min-width: 46rem) {
    .kural { grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr); }
  }

  .kural h3 {
    font-size: clamp(1.3rem, 0.9rem + 1.5vw, 1.85rem);
    font-weight: 680;
    letter-spacing: -0.022em;
    max-width: 13ch;
    align-self: start;
  }

  .kural p { color: var(--metin-2); max-width: 52ch; margin: 0; }

  .kural__kanit {
    display: inline-block;
    margin-top: 12px;
    font-size: var(--t-xs);
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--vurgu);
    border: 1px solid color-mix(in srgb, var(--vurgu) 42%, transparent);
    border-radius: 999px;
    padding: 5px 12px;
  }

  /* Uçurum: ürünün tezini tek görselde ve tek sayıda veriyor. */
  .ucurum {
    margin-top: clamp(32px, 5vw, 48px);
    display: grid;
    gap: clamp(28px, 4.5vw, 56px);
    align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 52rem) {
    .ucurum { grid-template-columns: 1.1fr 0.9fr; }
  }

  .ucurum__sayi {
    font-family: var(--yazi-baslik);
    font-size: clamp(3.4rem, 2rem + 6vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    margin: 0;
    color: var(--metin);
  }
  .ucurum__sayi span { color: var(--vurgu); }

  .ucurum__aciklama {
    margin-top: 18px;
    color: var(--metin-2);
    max-width: 44ch;
  }

  .ucurum__app {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 28px;
    padding: 16px 18px;
    border-radius: var(--yuvarlak-buyuk);
    border: 1px solid var(--ayrac);
    background: var(--yuzey-degrade), var(--yuzey);
    box-shadow: var(--dusey-gol-kucuk), var(--kenar-isik);
    text-decoration: none;
    color: var(--metin);
  }
  .ucurum__app:hover { border-color: color-mix(in srgb, var(--vurgu) 45%, var(--ayrac)); }
  .ucurum__app img { border-radius: 23%; flex: none; box-shadow: var(--dusey-gol-kucuk); }
  .ucurum__app span { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .ucurum__ad { display: flex; align-items: center; gap: 10px; font-weight: 400; }
  .ucurum__app strong { font-size: var(--t-l); font-weight: 670; letter-spacing: -0.02em; }
  .ucurum__app em { font-style: normal; font-size: var(--t-s); color: var(--metin-2); }

  .rozet {
    font-style: normal;
    flex: none;
    font-size: var(--t-xs);
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ham-golge);
    background: var(--vurgu);
    padding: 2px 9px;
    border-radius: 999px;
  }
</style>
