---
import Temel from '../layouts/Temel.astro';
import AnaEkran from '../components/AnaEkran.astro';
import { site, uygulamalar, sayfaIcin } from '../data/site.js';
---

<Temel
  baslik={`${site.ad} — ${site.slogan}`}
  aciklama="Günlük hayatı kolaylaştıran mobil uygulamalar üretiyoruz. Göremediğin şeyi, iş işten geçmeden gösteririz."
  cipli={false}
>
  <section class="giris">
    <div class="kabuk giris__ic">
      <div class="giris__yazi">
        <h1>{site.slogan}</h1>
        <p class="giris__alt">
          Mobil uygulamalar yapıyoruz. Hepsi tek bir soruya cevap veriyor ve
          cevabı, cevap hâlâ işe yarar durumdayken veriyor.
        </p>
        <p class="giris__dugmeler">
          <a class="dugme dugme--birincil" href={sayfaIcin('kademe')}>Kademe'yi incele</a>
          <a class="dugme dugme--ikincil" href="/hakkimizda.html">Neden Gnomon</a>
        </p>
      </div>
      <div class="giris__telefon">
        <AnaEkran />
      </div>
    </div>
  </section>

  <section class="kabuk bolum">
    <p class="etiket">Nasıl çalışıyoruz</p>
    <h2 class="bolum__baslik">Üç kural, üçü de Kademe'de görünür</h2>
    <ul class="ilkeler">
      <li>
        <h3>Bilmediğimizi söyleriz</h3>
        <p>
          Ay başında okuman yoksa Kademe bunu söyler ve sonucu{' '}
          <strong>“tahmini”</strong> diye işaretler. Yanlış bir güven
          vermektense eksik olduğunu bilmen daha iyi.
        </p>
      </li>
      <li>
        <h3>Veri sende kalır</h3>
        <p>
          Sayaç okumaların varsayılan olarak telefonundan çıkmaz. Hesaplar
          cihazında yapılır, internet gerekmez. Yedeklemeyi açmak{' '}
          <strong>senin kararın</strong>.
        </p>
      </li>
      <li>
        <h3>Tek soru, iyi cevap</h3>
        <p>
          Her uygulama tek bir soruya cevap veriyor. Soruyu çoğaltmak yerine
          cevabı iyileştirmeyi tercih ediyoruz.
        </p>
      </li>
    </ul>
  </section>

  <section class="kabuk bolum">
    <p class="etiket">Uygulamalarımız</p>
    {uygulamalar.map((u) => (
      <article class="serit">
        <img class="serit__ikon" src={u.ikon} alt="" width="72" height="72" />
        <div class="serit__govde">
          <h2>
            {u.ad}
            {u.durum === 'yakinda' && <span class="rozet">Yakında</span>}
          </h2>
          <p class="serit__ozet">{u.ozet}</p>
          <p class="serit__kanit">
            İstanbul'da Kasım limiti <strong>136,01 Sm³</strong>. Bir nefes
            aşarsan fatura 2.307 TL yerine 3.511 TL.{' '}
            <strong class="fark">Aradaki fark 1.204 TL</strong> ve bu fark
            aşan kısımdan değil, ayın tamamının pahalanmasından geliyor.
          </p>
          <p><a class="dugme dugme--ikincil" href={sayfaIcin(u.slug)}>{u.ad} sayfası</a></p>
        </div>
      </article>
    ))}
  </section>
</Temel>

<style>
  .giris {
    position: relative;
    padding-block: clamp(40px, 6vw, 88px) clamp(48px, 7vw, 96px);
    /* Işık sol üstten; sayfanın geri kalanı gölgeye doğru gidiyor */
    background: radial-gradient(
      110% 85% at 10% -5%,
      rgb(233 162 59 / 0.13) 0%,
      rgb(233 162 59 / 0.035) 38%,
      transparent 68%
    );
    border-bottom: 1px solid var(--ayrac);
  }

  .giris__ic {
    display: grid;
    gap: clamp(36px, 6vw, 64px);
    align-items: center;
    grid-template-columns: 1fr;
  }

  @media (min-width: 52rem) {
    .giris__ic { grid-template-columns: 1.05fr 0.95fr; }
  }

  .giris h1 {
    font-size: var(--t-3xl);
    font-weight: 700;
    max-width: 15ch;
  }

  .giris__alt {
    margin-top: 24px;
    max-width: 44ch;
    font-size: var(--t-l);
    color: var(--metin-2);
  }

  .giris__dugmeler {
    margin-top: 32px;
    display: flex;
    gap: 12px;          /* 12px: dokunma hedefleri arası asgari boşluk */
    flex-wrap: wrap;
  }

  .giris__telefon { display: flex; justify-content: center; }

  .bolum { padding-block: clamp(48px, 7vw, 88px); }
  .bolum__baslik { margin-top: 10px; max-width: 20ch; }

  .ilkeler {
    list-style: none;
    padding: 0;
    margin: 36px 0 0;
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .ilkeler li {
    padding: 24px;
    border: 1px solid var(--ayrac);
    border-radius: var(--yuvarlak-buyuk);
    background: var(--yuzey);
    box-shadow: var(--dusey-gol-kucuk), var(--kenar-isik);
  }

  .ilkeler h3 { margin-bottom: 10px; }
  .ilkeler p { color: var(--metin-2); margin: 0; }

  .serit {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    margin-top: 24px;
    padding: 28px;
    border: 1px solid var(--ayrac);
    border-radius: var(--yuvarlak-buyuk);
    background: var(--yuzey);
    box-shadow: var(--dusey-gol-kucuk), var(--kenar-isik);
    flex-wrap: wrap;
  }

  .serit__ikon { border-radius: 23%; flex: none; box-shadow: var(--dusey-gol-kucuk); }
  .serit__govde { flex: 1; min-width: min(100%, 18rem); }

  .serit h2 { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

  .rozet {
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ham-golge);
    background: var(--vurgu);
    padding: 3px 10px;
    border-radius: 999px;
  }

  .serit__ozet { margin-top: 10px; color: var(--metin-2); max-width: 54ch; }

  .serit__kanit {
    margin-top: 16px;
    padding-left: 16px;
    border-left: 2px solid var(--vurgu);
    color: var(--metin-2);
    max-width: 54ch;
  }
  .serit__kanit .fark { color: var(--metin); }

  .serit__govde p:last-child { margin-top: 20px; margin-bottom: 0; }
</style>
