---
/* Gnomonun ne olduğunu gösteren şema.
 *
 * Hakkımızda sayfası adın hikâyesini anlatıyordu ama hiçbir yerde
 * gnomonu GÖSTERMİYORDU. Oysa anlatılacak şey tam olarak bu: ışık gelir,
 * bir cisim onu keser, geriye okunabilir bir gölge kalır.
 *
 * Geometri uydurma değil: ışınlar 38°, yani sitenin ışık kuralıyla aynı
 * açı. Gölgenin ucu, çubuğun tepesinden geçen ışının zemine değdiği
 * yerde bitiyor — hesaplanarak kondu, göz kararı değil.
 */
const AMBER = '#E9A23B';
---

<figure class="sema">
  <svg viewBox="0 0 480 248" role="img" aria-labelledby="gs-b gs-a">
    <title id="gs-b">Güneş saatinin çalışması</title>
    <desc id="gs-a">
      Soldan gelen ışınlar dik duran çubuğu keser; çubuğun gölgesi zemine
      düşer ve saati okunur kılar.
    </desc>

    <!-- engellenmeyen ışınlar -->
    <g stroke={AMBER} stroke-opacity="0.55" stroke-width="1.6" stroke-linecap="round">
      <line x1="100" y1="10" x2="337.9" y2="196" />
      <line x1="130" y1="10" x2="367.9" y2="196" />
      <line x1="160" y1="10" x2="397.9" y2="196" />
    </g>
    <!-- çubuğa çarpan ışınlar -->
    <g stroke={AMBER} stroke-opacity="0.9" stroke-width="1.6" stroke-linecap="round">
      <line x1="30" y1="10" x2="170" y2="119.4" />
      <line x1="50" y1="10" x2="170" y2="103.8" />
      <line x1="72.8" y1="10" x2="170" y2="86" />
    </g>

    <!-- tepeden geçen ışının devamı: gölgenin sınırı -->
    <line x1="170" y1="86" x2="310.7" y2="196"
          stroke={AMBER} stroke-opacity="0.32" stroke-width="1.5" stroke-dasharray="3 5" />

    <!-- AYDINLIK ZEMİN. Gölge bunun üzerine boyanmıyor, bundan
         KESİLİYOR — koyu zeminde koyu bir gölge görünmez; logodaki
         mantığın aynısı. -->
    <rect x="40" y="196" width="400" height="11" rx="2"
          fill="currentColor" fill-opacity="0.2" />
    <!-- gölge: aydınlık zemindeki boşluk -->
    <rect x="170" y="196" width="140.7" height="11" rx="2"
          fill="#0C0B07" fill-opacity="0.92" />

    <!-- saat çentikleri -->
    <g stroke="currentColor" stroke-opacity="0.26" stroke-width="1.5">
      {[70, 110, 150, 190, 230, 270, 310, 350, 390, 430].map((x) => (
        <line x1={x} y1="213" x2={x} y2="219" />
      ))}
    </g>

    <!-- gölgenin ucu: saatin okunduğu yer -->
    <circle cx="310.7" cy="201.5" r="4.5" fill={AMBER} />

    <!-- gnomon: ışığı kesen çubuk -->
    <path d="M170 196 L170 86 L206 196 Z" fill="currentColor" />

    <text x="34" y="30" fill={AMBER} font-size="13" font-weight="620">ışık</text>
    <text x="180" y="74" fill="currentColor" fill-opacity="0.9"
          font-size="13" font-weight="620">gnomon</text>
    <text x="206" y="236" fill="currentColor" fill-opacity="0.62"
          font-size="13" font-weight="620">gölge</text>
    <text x="300" y="236" fill={AMBER} fill-opacity="0.9"
          font-size="13" font-weight="620">ucu = saat</text>
  </svg>
  <figcaption>
    Çubuk hiçbir şey üretmez. Yalnızca ışığı keser — ve zaten orada olan
    şey okunabilir hâle gelir.
  </figcaption>
</figure>

<style>
  .sema {
    margin: 0;
    padding: 26px 24px 20px;
    border: 1px solid var(--ayrac);
    border-radius: var(--yuvarlak-buyuk);
    background: var(--yuzey-degrade), var(--yuzey);
    box-shadow: var(--dusey-gol-kucuk), var(--kenar-isik);
    color: var(--metin);
  }
  .sema svg { width: 100%; height: auto; display: block; overflow: visible; }
  figcaption {
    margin-top: 16px;
    font-size: var(--t-s);
    color: var(--metin-2);
    max-width: 46ch;
  }
</style>
