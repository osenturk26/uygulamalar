---
/* Kademe'nin iOS orta boy (4×2) widget'ı.
 *
 * Sayılar uydurma değil: İstanbul Kasım 2026 limiti 136,01 Sm³, uygulamanın
 * kendi ekran görüntüsündeki durum (docs/store/screenshots-kaynak/01.jpg).
 * Halka %35,3 dolu çünkü 48,00 / 136,01 = 0,353. Renk amber, çünkü ay sonu
 * projeksiyonu (180,00) limiti aşıyor — uygulamanın "Aşım riski" hâli.
 *
 * Renk Kademe'nin KENDİ durum tonu (#FFB224, app_colors.dart › dark.atRisk),
 * sitenin vurgu amberi değil. İkisi ayrı kalmalı: site amberi "marka",
 * buradaki amber "uyarı" demek (TASARIM.md §3.2).
 *
 * Metin gerçek metin, görsel değil — ekran okuyucu okuyabilsin diye.
 */
const tuketim = '48,00';
const limit = '136,01';
const yuzde = 35.3;
const kalanGun = 22;
---

<div class="widget">
  <div class="widget__halka" aria-hidden="true">
    <svg viewBox="0 0 100 100" role="presentation">
      <circle class="iz" cx="50" cy="50" r="38" />
      <circle
        class="dolu"
        cx="50" cy="50" r="38"
        pathLength="100"
        style={`--yuzde:${yuzde}`}
      />
    </svg>
    <div class="widget__sayi">
      <span class="widget__deger">{tuketim}</span>
      <span class="widget__birim">Sm³</span>
    </div>
  </div>

  <div class="widget__bilgi">
    <p class="widget__ad">Kademe</p>
    <p class="widget__limit">{limit} Sm³ limitte</p>
    <p class="widget__cip"><span aria-hidden="true">⚠</span> Aşım riski</p>
    <p class="widget__gun">Ay sonuna {kalanGun} gün</p>
  </div>

  <span class="gizli">
    Kademe: bu ay {tuketim} metreküp kullanıldı, limit {limit} metreküp.
    Aşım riski var. Ay sonuna {kalanGun} gün kaldı.
  </span>
</div>

<style>
  .widget {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1em;
    padding: 1.05em 1.15em;
    border-radius: 1.5em;
    /* iOS widget malzemesi: içerik katmanının üstünde yüzen, arkasını
     * bulanıklaştıran bir yüzey. Duvar kağıdı arkasından geçiyor. */
    background: rgb(28 28 30 / 0.66);
    backdrop-filter: blur(22px) saturate(140%);
    -webkit-backdrop-filter: blur(22px) saturate(140%);
    box-shadow:
      0 1.2em 2.2em -0.9em rgb(0 0 0 / 0.6),
      inset 0 0 0 1px rgb(255 255 255 / 0.08);
    color: #fff;
    line-height: 1.25;
  }

  .widget p { margin: 0; }

  .widget__halka {
    position: relative;
    flex: none;
    width: 6.6em;
    height: 6.6em;
  }

  .widget__halka svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg); /* 12 yönünden başlasın */
  }

  .iz {
    fill: none;
    stroke: rgb(255 255 255 / 0.14);
    stroke-width: 8;
  }

  .dolu {
    fill: none;
    stroke: #FFB224;           /* Kademe dark.atRisk.fill */
    stroke-width: 8;
    stroke-linecap: round;
    stroke-dasharray: var(--yuzde) 100;
    filter: drop-shadow(0 0 0.35em rgb(255 178 36 / 0.45));
    animation: cizil 1100ms cubic-bezier(0.22, 0.75, 0.3, 1) both;
  }

  /* Tek koreografi anı: halka bir kez dolarak gelir. "Hareketi azalt"
   * açıkken global kural bunu son karesine sabitliyor. */
  @keyframes cizil {
    from { stroke-dasharray: 0 100; }
  }

  .widget__sayi {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.05em;
  }

  .widget__deger {
    font-size: 1.35em;
    font-weight: 680;
    letter-spacing: -0.03em;
  }

  .widget__birim {
    font-size: 0.62em;
    color: rgb(255 255 255 / 0.62);
  }

  .widget__bilgi { min-width: 0; }

  .widget__ad {
    font-size: 0.72em;
    font-weight: 640;
    color: rgb(255 255 255 / 0.55);
    letter-spacing: 0.02em;
  }

  .widget__limit {
    font-size: 0.88em;
    font-weight: 560;
    margin-top: 0.3em !important;
  }

  .widget__cip {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-top: 0.55em !important;
    padding: 0.3em 0.7em;
    border-radius: 999px;
    font-size: 0.72em;
    font-weight: 640;
    color: #FFB224;
    background: rgb(255 178 36 / 0.16);
    box-shadow: inset 0 0 0 1px rgb(255 178 36 / 0.3);
  }

  .widget__gun {
    margin-top: 0.5em !important;
    font-size: 0.7em;
    color: rgb(255 255 255 / 0.5);
  }

  .gizli {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
