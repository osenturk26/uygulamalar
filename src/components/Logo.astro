---
/* Gnomon markası: güneş saati kadranı, üzerinde gölge yarığı.
 *
 * Gnomon, güneş saatinin gölgeyi düşüren çubuğu. Marka da onu gösteriyor:
 * güneş vuran kadran ve merkezden kenara uzanan gölge.
 *
 * Üç karar:
 * 1. TEK YOL, TEK RENK. Gölge boyalı değil, kadrandan ÇIKARILMIŞ bir
 *    oyuk. Böylece koyu zeminde de açık zeminde de aynı şekil, monokromda
 *    ve tek renk baskıda da çalışıyor.
 * 2. Yarık kenara kadar gidiyor ve siluete çentik açıyor. Merkeze doğru
 *    sivrilen bir dilim bıraksaydık pasta grafiği okunuyordu — denendi.
 * 3. Gölgenin açısı 38°, yani sitenin ışık kuralıyla aynı: ışık sol
 *    üstten gelir, gölge sağ alta düşer.
 *
 * Elenen yönler: ince üçgen + taban çizgisi (yelkenli okunuyordu),
 * köşeden bölünmüş yuvarlak kare (app ikonu sanılıyordu), G harfi
 * (kelime markasının yanında kendini tekrar ediyordu).
 */
interface Props { boyut?: number; sinif?: string; }
const { boyut = 26, sinif } = Astro.props;
---

<svg
  class={sinif}
  width={boyut}
  height={boyut}
  viewBox="0 0 44 44"
  role="img"
  aria-label="Gnomon Studio"
  fill="currentColor"
>
  <path d="M35.63 37.98 A21.0 21.0 0 1 1 40.8 31.36 L24.59 18.69 L19.41 25.31 Z" />
</svg>
