---
/* Uygulamanın özet kartı: kota halkası + dört ölçü.
 * Değerler uygulamanın kendi ekranından (screenshots-kaynak/01.jpg):
 * 48,00 kullanıldı · 136,01 limit · kalan 88,01 · ay sonu tahmini 180,00. */
const AMBER = '#FFB224'; /* dark.atRisk.fill */
const yuzde = 35.3;
---

<div class="kart">
  <div class="kart__halka">
    <svg viewBox="0 0 100 100" aria-hidden="true">
      <circle class="iz" cx="50" cy="50" r="40" />
      <circle class="dolu" cx="50" cy="50" r="40" pathLength="100"
              style={`--yuzde:${yuzde}`} />
    </svg>
    <div class="kart__orta">
      <span class="kart__deger">48,00</span>
      <span class="kart__birim">Sm³</span>
      <span class="kart__limit">136,01 Sm³ limitte</span>
    </div>
  </div>

  <p class="kart__cip"><span aria-hidden="true">⚠</span> Aşım riski</p>

  <dl class="olculer">
    <div><dt>Kalan kota</dt><dd>88,01 <i>Sm³</i></dd></div>
    <div><dt>Ay sonu tahmini</dt><dd class="uyari">180,00 <i>Sm³</i></dd></div>
    <div><dt>Günlük ortalamanız</dt><dd>6,0 <i>Sm³</i></dd></div>
    <div><dt>Ay sonuna</dt><dd>22 <i>gün</i></dd></div>
  </dl>
</div>

<style>
  .kart {
    padding: 28px 24px 24px;
    border-radius: var(--yuvarlak-buyuk);
    background: #141416;
    box-shadow:
      var(--dusey-gol),
      inset 0 0 0 1px rgb(255 255 255 / 0.07),
      inset 0 90px 120px -70px rgb(255 178 36 / 0.22);
    color: #fff;
    max-width: 380px;
    margin-inline: auto;
  }

  .kart__halka { position: relative; width: 190px; margin: 0 auto; aspect-ratio: 1; }
  .kart__halka svg { width: 100%; height: 100%; transform: rotate(-90deg); }

  .iz { fill: none; stroke: rgb(255 255 255 / 0.12); stroke-width: 7; }
  .dolu {
    fill: none;
    stroke: #FFB224;
    stroke-width: 7;
    stroke-linecap: round;
    stroke-dasharray: var(--yuzde) 100;
    filter: drop-shadow(0 0 6px rgb(255 178 36 / 0.5));
    animation: dol 1200ms cubic-bezier(0.22, 0.75, 0.3, 1) both;
  }
  @keyframes dol { from { stroke-dasharray: 0 100; } }

  .kart__orta {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .kart__deger { font-size: 42px; font-weight: 700; letter-spacing: -0.035em; line-height: 1; }
  .kart__birim { font-size: 13px; color: rgb(255 255 255 / 0.6); margin-top: 2px; }
  .kart__limit { font-size: 12px; color: rgb(255 255 255 / 0.45); margin-top: 8px; }

  .kart__cip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    width: fit-content;
    margin: 18px auto 0;
    padding: 8px 18px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 650;
    color: #FFB224;
    background: rgb(255 178 36 / 0.14);
    box-shadow: inset 0 0 0 1px rgb(255 178 36 / 0.32);
  }

  .olculer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 16px;
    margin: 24px 0 0;
    padding-top: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.1);
  }
  .olculer dt { font-size: 12.5px; color: rgb(255 255 255 / 0.55); }
  .olculer dd {
    margin: 4px 0 0;
    font-size: 20px;
    font-weight: 670;
    letter-spacing: -0.02em;
  }
  .olculer dd i { font-style: normal; font-size: 12.5px; font-weight: 500; color: rgb(255 255 255 / 0.55); }
  .olculer .uyari { color: #FFB224; }
</style>
